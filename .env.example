VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANTE: VITE_SUPABASE_ANON_KEY debe ser la clave "anon / public"
# (Supabase Dashboard > Settings > API > Project API keys > anon public).
# NUNCA pegues acá la "service_role" — esa key salta la seguridad (RLS)
# y solo debe usarse del lado del servidor (Edge Functions), donde
# Supabase ya la inyecta automáticamente como SUPABASE_SERVICE_ROLE_KEY.
